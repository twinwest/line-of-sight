{
  "name": "line-of-sight",
  "version": "0.1.2",
  "description": "Your Claude Code and Codex sessions as a readable local page. Select any line and ask — the agent's context stays untouched.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sight": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && vite build web",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "test": "vitest run",
    "dev": "vite web",
    "prepublishOnly": "npm run build",
    "preversion": "npm run typecheck && npm run test",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.0",
    "fastify": "^5.0.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  },
  "author": "Ray Qian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinwest/line-of-sight.git"
  },
  "homepage": "https://github.com/twinwest/line-of-sight#readme",
  "files": [
    "dist",
    "web/dist"
  ]
}
